# ---------------------------------------------------------------------------
# Qeet ID Docs — environment
# Copy to `.env.local` for local dev; set in the Vercel project for deploys.
# All values are PUBLIC (NEXT_PUBLIC_*) — this portal has no server secrets.
# ---------------------------------------------------------------------------

# Canonical site origin. Drives canonical URLs, Open Graph, sitemap and RSS.
# Vercel preview deployments can override this per-environment.
NEXT_PUBLIC_SITE_URL=https://docs.qeet.in

# Optional, off by default: enable cookieless Plausible analytics by setting
# the site domain (e.g. docs.qeet.in). Leave empty to ship zero tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
